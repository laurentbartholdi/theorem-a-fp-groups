            Exists.casesOn.{1} right fun a ha =>
              Exists.casesOn.{u + 2} (hU r T G) fun 𝒞 h =>
                And.casesOn.{0} h fun hbase right =>
                  And.casesOn.{0} right fun hK hH =>
                    Exists.casesOn.{u + 2} (TheoremA.proposition_7_1.{u} h31 h52 r T a hr hw hg ha G 𝒞 hbase hK hH n hn)
                      fun B h =>
                      Exists.casesOn.{u + 1} h fun w h =>
                        And.casesOn.{0} h fun left right =>
                          And.casesOn.{0} right fun hFP right =>
                            And.casesOn.{0} right fun hGB right =>
                              Exists.intro.{u + 2} B (Exists.intro.{u + 1} inferInstance.{u + 1} ⟨hFP, hGB⟩)
