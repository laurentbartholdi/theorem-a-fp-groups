def TheoremA.IsFP.{u_1} : Nat → (G : Type u_1) → [Group.{u_1} G] → Prop :=
fun n G [Group.{u_1} G] =>
  ∃ c d ε,
    And
      (∀ (g : G) (x : TheoremA.FreeMod.{u_1} G (c 0)),
        Eq.{1} (ε (HSMul.hSMul.{u_1, u_1, u_1} ((MonoidAlgebra.of.{0, u_1} Int G) g) x)) (ε x))
      (And (Function.Surjective.{u_1 + 1, 1} ⇑ε)
        (And
          (LT.lt.{0} 0 n →
            Eq.{u_1 + 1} (AddMonoidHom.ker.{u_1, 0} ε)
              (Submodule.toAddSubgroup.{u_1, u_1} (LinearMap.range.{u_1, u_1, u_1, u_1} (d 0))))
          (∀ (i : Nat),
            LT.lt.{0} (HAdd.hAdd.{0, 0, 0} i 1) n →
              Eq.{u_1 + 1} (LinearMap.ker.{u_1, u_1, u_1, u_1} (d i))
                (LinearMap.range.{u_1, u_1, u_1, u_1} (d (HAdd.hAdd.{0, 0, 0} i 1))))))
def TheoremA.TheoremAStatement.{u} : Prop :=
∀ (n : Nat),
  LE.le.{0} 2 n →
    ∀ (G : Type u) [inst : Group.{u} G] [Countable.{u + 1} G],
      ∃ E x, And (TheoremA.IsFP.{u} n E) (∃ f, Function.Injective.{u + 1, u + 1} ⇑f)
def FanoTriples.triples : List.{0} TripleSystem.Triple :=
HAppend.hAppend.{0, 0, 0}
  (HAppend.hAppend.{0, 0, 0} (List.map.{0, 0} FanoTriples.pointTriple (List.range 7))
    (List.map.{0, 0} FanoTriples.lineTriple (List.range 7)))
  (List.cons.{0} FanoTriples.gamma List.nil.{0})
def FanoTriples.pointTriple : Nat → TripleSystem.Triple :=
fun p =>
  Prod.mk.{0, 0} (FanoTriples.flag0 p)
    (Prod.mk.{0, 0} (FanoTriples.flag1 (HMod.hMod.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} p 6) 7))
      (ite.{1} (Eq.{1} p 3) FanoTriples.b (FanoTriples.flag3 (HMod.hMod.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} p 4) 7))))
def FanoTriples.lineTriple : Nat → TripleSystem.Triple :=
fun j =>
  Prod.mk.{0, 0} (FanoTriples.flag0 j)
    (Prod.mk.{0, 0} (FanoTriples.flag1 j) (ite.{1} (Eq.{1} j 0) FanoTriples.a (FanoTriples.flag3 j)))
def FanoTriples.nu : Fin (List.length.{0} FanoTriples.triples) → Int :=
fun l => ite.{1} (LT.lt.{0} (↑l) 7) 1 (ite.{1} (LT.lt.{0} (↑l) 14) (-1) 1)
