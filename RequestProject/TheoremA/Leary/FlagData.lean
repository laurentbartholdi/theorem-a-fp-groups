/-!
# Raw tables for the fixed flag complex `flagL`

Generated by `scripts/leary_flag_complex.py`: a collar-and-cone flag triangulation of the
presentation complex of `⟨s, t | s² = tst, s³ = t⁵⟩` (the binary icosahedral group) with
61 vertices, 216 edges and 156 triangles.  Lookup tables are balanced binary trees indexed by the
binary digits of the index (`LTree.get`), so that kernel evaluation is fast.  Nothing here is
trusted: every property used is re-checked in Lean by kernel evaluation in `Leary/Instance.lean`.
-/

@[expose] public section

namespace TheoremA.Leary

/-- Binary lookup trees. -/
inductive LTree (α : Type) where
  | leaf : α → LTree α
  | node : LTree α → LTree α → LTree α

/-- Lookup by the binary digits of the index (least significant first). -/
def LTree.get {α : Type} : LTree α → Nat → α
  | .leaf a, _ => a
  | .node l r, i => if i % 2 = 0 then l.get (i / 2) else r.get (i / 2)

